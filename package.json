{
  "name": "leo-handover-simulation-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "cesium": "^1.141.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "satellite.js": "^7.0.1",
    "vite": "^7.2.7",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "jsdom": "^27.3.0",
    "supertest": "^7.1.4",
    "vitest": "^4.0.15"
  }
}
